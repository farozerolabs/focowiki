# Admin API
APP_ENV=development
LOG_LEVEL=debug

# Runtime log files
LOG_FILE_DIR=logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_MAX_FILES=5
LOG_FILE_MAX_TOTAL_BYTES=67108864
LOG_FILE_RETENTION_DAYS=7

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_SESSION_COOKIE_SECURE=false
ADMIN_SESSION_COOKIE_SAME_SITE=Lax
ADMIN_API_PORT=43000
ADMIN_API_PROXY_TARGET=http://127.0.0.1:43000
ADMIN_PUBLIC_ORIGIN=http://localhost:43100
ADMIN_API_PUBLIC_ORIGIN=http://localhost:43000
ADMIN_TRUSTED_ORIGINS=http://localhost:43100,http://127.0.0.1:43100
ALLOWED_HOSTS=
TRUSTED_PROXY_MODE=false

# Required infrastructure
POSTGRES_DB=focowiki
POSTGRES_USER=focowiki
POSTGRES_PASSWORD=focowiki
POSTGRES_PORT=55432
DATABASE_URL=postgres://focowiki:focowiki@127.0.0.1:55432/focowiki
DATABASE_POOL_MAX=10
REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379/0

# Search service: OpenSearch is the local default.
SEARCH_PROVIDER=opensearch
SEARCH_INDEX_PREFIX=focowiki_dev
COMPOSE_PROFILES=opensearch
OPENSEARCH_PORT=59200
OPENSEARCH_URL=http://127.0.0.1:59200
OPENSEARCH_AUTH_MODE=none
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_PASSWORD_FILE=
OPENSEARCH_CA_FILE=
OPENSEARCH_AWS_REGION=
OPENSEARCH_AWS_SERVICE=es
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# Meilisearch alternative: set SEARCH_PROVIDER and COMPOSE_PROFILES to meilisearch.
MEILI_HOST=http://127.0.0.1:57700
MEILI_MASTER_KEY=focowiki-development-master-key
MEILI_API_KEY=focowiki-development-master-key
MEILI_METRICS_API_KEY=focowiki-development-master-key
MEILI_API_KEY_FILE=
MEILI_METRICS_API_KEY_FILE=
MEILI_MAX_INDEXING_MEMORY=1GiB
MEILI_MAX_INDEXING_THREADS=2
MEILI_SNAPSHOT_DIR=/meili_snapshots
MEILI_SCHEDULE_SNAPSHOT=86400
MEILI_DUMP_DIR=/meili_dumps

# Developer OpenAPI
PUBLIC_OPENAPI_PORT=43200
PUBLIC_BASE_URL=http://127.0.0.1:43200
PUBLIC_OPENAPI_PUBLIC_ORIGIN=http://localhost:43200

# Admin UI
ADMIN_UI_HOST=0.0.0.0
ADMIN_UI_PORT=43100
VITE_ADMIN_API_BASE_URL=

# S3-compatible storage
S3_PORT=43300
S3_ENDPOINT=http://127.0.0.1:43300
S3_REGION=local
S3_BUCKET=focowiki
S3_ACCESS_KEY_ID=focowiki-dev
S3_SECRET_ACCESS_KEY=focowiki-development-secret
# Object-key namespace used by local development.
S3_PREFIX=dev
S3_FORCE_PATH_STYLE=true

# Pagination and content read limits
ADMIN_LIST_DEFAULT_PAGE_SIZE=50
ADMIN_LIST_MAX_PAGE_SIZE=200
TREE_CHILD_DEFAULT_PAGE_SIZE=100
TREE_CHILD_MAX_PAGE_SIZE=500
PAGINATION_CURSOR_TTL_SECONDS=900
GENERATED_CONTENT_MAX_BYTES=10485760

# Worker startup settings
SOURCE_WORKER_DATABASE_POOL_MAX=6
PUBLICATION_WORKER_DATABASE_POOL_MAX=4
MAINTENANCE_WORKER_DATABASE_POOL_MAX=2

# Security audit
SECURITY_AUDIT_RETENTION_DAYS=30
