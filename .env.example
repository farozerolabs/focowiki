# Deployment environment template
# Copy this file to .env and replace every placeholder before production use.

# Runtime mode
APP_ENV=production
LOG_LEVEL=info

# Runtime log files
LOG_FILE_DIR=logs
LOG_FILE_MAX_BYTES=10485760
LOG_FILE_MAX_FILES=5
LOG_FILE_MAX_TOTAL_BYTES=67108864
LOG_FILE_RETENTION_DAYS=7

# Deployment images
FOCOWIKI_API_IMAGE=ghcr.io/farozerolabs/focowiki-api:latest
FOCOWIKI_SOURCE_WORKER_IMAGE=ghcr.io/farozerolabs/focowiki-source-worker:latest
FOCOWIKI_ADMIN_IMAGE=ghcr.io/farozerolabs/focowiki-admin:latest

# Admin auth
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<set-admin-password>
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_SESSION_COOKIE_SECURE=true
ADMIN_SESSION_COOKIE_SAME_SITE=Lax

# Admin API
ADMIN_API_PORT=43000
ADMIN_API_PROXY_TARGET=http://api:43000
ADMIN_PUBLIC_ORIGIN=https://admin.example.com
ADMIN_API_PUBLIC_ORIGIN=https://admin-api.example.com
ADMIN_TRUSTED_ORIGINS=https://admin.example.com
ALLOWED_HOSTS=admin.example.com,admin-api.example.com,openapi.example.com,127.0.0.1,localhost
TRUSTED_PROXY_MODE=true

# Required infrastructure
POSTGRES_DB=focowiki
POSTGRES_USER=focowiki
POSTGRES_PASSWORD=<generate-a-postgres-password>
DATABASE_URL=postgres://focowiki:<generate-a-postgres-password>@postgres:5432/focowiki
DATABASE_POOL_MAX=12
REDIS_URL=redis://redis:6379/0

# Search service: OpenSearch is the bundled default.
SEARCH_PROVIDER=opensearch
SEARCH_INDEX_PREFIX=focowiki
COMPOSE_PROFILES=opensearch
OPENSEARCH_URL=https://opensearch:9200
OPENSEARCH_AUTH_MODE=basic
OPENSEARCH_USERNAME=focowiki-runtime
OPENSEARCH_PASSWORD=
OPENSEARCH_PASSWORD_FILE=/app/runtime-secrets/opensearch-password
OPENSEARCH_CA_FILE=/app/runtime-secrets/opensearch-ca.pem
OPENSEARCH_AWS_REGION=
OPENSEARCH_AWS_SERVICE=es
OPENSEARCH_ADMIN_PASSWORD=<generate-an-opensearch-admin-password>
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# Meilisearch alternative: set SEARCH_PROVIDER and COMPOSE_PROFILES to meilisearch.
MEILI_HOST=http://meilisearch:7700
MEILI_MASTER_KEY=<generate-a-meilisearch-master-key>
MEILI_API_KEY=
MEILI_METRICS_API_KEY=
MEILI_API_KEY_FILE=/app/runtime-secrets/meilisearch-api-key
MEILI_METRICS_API_KEY_FILE=/app/runtime-secrets/meilisearch-metrics-key
MEILI_MAX_INDEXING_MEMORY=2GiB
MEILI_MAX_INDEXING_THREADS=2
MEILI_SNAPSHOT_DIR=/meili_snapshots
MEILI_SCHEDULE_SNAPSHOT=86400
MEILI_DUMP_DIR=/meili_dumps

# Developer OpenAPI
PUBLIC_OPENAPI_PORT=43200
PUBLIC_BASE_URL=https://openapi.example.com
PUBLIC_OPENAPI_PUBLIC_ORIGIN=https://openapi.example.com

# Admin UI
ADMIN_UI_PORT=43100

# S3-compatible storage
S3_ENDPOINT=https://s3.example.com
S3_REGION=<set-storage-region>
S3_BUCKET=<set-storage-bucket>
S3_ACCESS_KEY_ID=<set-storage-access-key-id>
S3_SECRET_ACCESS_KEY=<generate-a-storage-secret>
S3_PREFIX=production
S3_FORCE_PATH_STYLE=<true-or-false>

# Pagination and content read limits
ADMIN_LIST_DEFAULT_PAGE_SIZE=50
ADMIN_LIST_MAX_PAGE_SIZE=200
TREE_CHILD_DEFAULT_PAGE_SIZE=100
TREE_CHILD_MAX_PAGE_SIZE=500
PAGINATION_CURSOR_TTL_SECONDS=900
GENERATED_CONTENT_MAX_BYTES=10485760

# Worker startup settings
SOURCE_WORKER_DATABASE_POOL_MAX=8
SOURCE_WORKER_CPUS=2.0
SOURCE_WORKER_MEMORY_LIMIT=2g
SOURCE_WORKER_PIDS_LIMIT=128
PUBLICATION_WORKER_DATABASE_POOL_MAX=4
MAINTENANCE_WORKER_DATABASE_POOL_MAX=2

# Security audit
SECURITY_AUDIT_RETENTION_DAYS=30
