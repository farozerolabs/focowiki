x-docker-logging: &docker-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

x-runtime-environment: &runtime-environment
  DATABASE_URL: postgres://${POSTGRES_USER:?Set POSTGRES_USER in .env}:${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD in .env}@postgres:5432/${POSTGRES_DB:?Set POSTGRES_DB in .env}
  REDIS_URL: redis://redis:6379/0
  S3_ENDPOINT: http://minio:9000
  MEILI_HOST: http://meilisearch:7700
  MEILI_MASTER_KEY: ""
  MEILI_API_KEY: ""
  MEILI_METRICS_API_KEY: ""
  MEILI_API_KEY_FILE: /app/runtime-secrets/meilisearch-api-key
  MEILI_METRICS_API_KEY_FILE: /app/runtime-secrets/meilisearch-metrics-key
  MEILI_INDEX_PREFIX: ${MEILI_INDEX_PREFIX:?Set MEILI_INDEX_PREFIX in .env}

services:
  admin:
    image: focowiki-admin:dev
    build:
      context: .
      dockerfile: Dockerfile
      target: admin
    environment:
      ADMIN_API_PROXY_TARGET: http://api:${ADMIN_API_PORT:?Set ADMIN_API_PORT in .env}
    ports:
      - "127.0.0.1:${ADMIN_UI_PORT:?Set ADMIN_UI_PORT in .env}:8080"
    depends_on:
      api:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "[ \"$(wget -qO- http://127.0.0.1:8080/healthz)\" = \"ok\" ]"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 10s
    logging: *docker-logging
    restart: unless-stopped

  api:
    image: focowiki-api:dev
    build:
      context: .
      dockerfile: Dockerfile
      target: api
    env_file:
      - .env
    environment: *runtime-environment
    ports:
      - "127.0.0.1:${ADMIN_API_PORT:?Set ADMIN_API_PORT in .env}:${ADMIN_API_PORT:?Set ADMIN_API_PORT in .env}"
      - "127.0.0.1:${PUBLIC_OPENAPI_PORT:?Set PUBLIC_OPENAPI_PORT in .env}:${PUBLIC_OPENAPI_PORT:?Set PUBLIC_OPENAPI_PORT in .env}"
    volumes:
      - ./logs:/app/logs
      - ./runtime-secrets:/app/runtime-secrets
    depends_on:
      migrate:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "node", "apps/api/runtime/main.mjs", "--healthcheck"]
      interval: 10s
      timeout: 15s
      retries: 12
      start_period: 20s
    logging: *docker-logging
    restart: unless-stopped

  source-worker:
    image: focowiki-api:dev
    build:
      context: .
      dockerfile: Dockerfile
      target: api
    command: ["node", "--max-old-space-size=256", "apps/api/runtime/source-worker.mjs"]
    env_file:
      - .env
    environment: *runtime-environment
    volumes:
      - ./logs:/app/logs
      - ./runtime-secrets:/app/runtime-secrets
    depends_on:
      migrate:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "node", "apps/api/runtime/source-worker.mjs", "--healthcheck"]
      interval: 15s
      timeout: 15s
      retries: 8
      start_period: 20s
    stop_grace_period: 30s
    logging: *docker-logging
    restart: unless-stopped

  publication-worker:
    image: focowiki-api:dev
    build:
      context: .
      dockerfile: Dockerfile
      target: api
    command: ["node", "--max-old-space-size=512", "apps/api/runtime/publication-worker.mjs"]
    env_file:
      - .env
    environment: *runtime-environment
    volumes:
      - ./logs:/app/logs
      - ./runtime-secrets:/app/runtime-secrets
    depends_on:
      migrate:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "node", "apps/api/runtime/publication-worker.mjs", "--healthcheck"]
      interval: 15s
      timeout: 15s
      retries: 8
      start_period: 20s
    stop_grace_period: 30s
    logging: *docker-logging
    restart: unless-stopped

  maintenance-worker:
    image: focowiki-api:dev
    build:
      context: .
      dockerfile: Dockerfile
      target: api
    command: ["node", "apps/api/runtime/maintenance-worker.mjs"]
    env_file:
      - .env
    environment: *runtime-environment
    volumes:
      - ./logs:/app/logs
      - ./runtime-secrets:/app/runtime-secrets
    depends_on:
      migrate:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "node", "apps/api/runtime/maintenance-worker.mjs", "--healthcheck"]
      interval: 30s
      timeout: 15s
      retries: 8
      start_period: 20s
    stop_grace_period: 30s
    logging: *docker-logging
    restart: unless-stopped

  meilisearch-init:
    image: focowiki-api:dev
    build:
      context: .
      dockerfile: Dockerfile
      target: api
    command: ["node", "apps/api/runtime/meilisearch-bootstrap.mjs"]
    environment:
      MEILI_HOST: http://meilisearch:7700
      MEILI_MASTER_KEY: ${MEILI_MASTER_KEY:?Set MEILI_MASTER_KEY in .env}
      MEILI_API_KEY: ""
      MEILI_METRICS_API_KEY: ""
      MEILI_INDEX_PREFIX: ${MEILI_INDEX_PREFIX:?Set MEILI_INDEX_PREFIX in .env}
      MEILI_SECRET_DIR: /app/runtime-secrets
    volumes:
      - ./runtime-secrets:/app/runtime-secrets
    depends_on:
      meilisearch:
        condition: service_healthy
        required: false
    logging: *docker-logging
    restart: "no"

  migrate:
    image: focowiki-api:dev
    build:
      context: .
      dockerfile: Dockerfile
      target: api
    command: ["node", "apps/api/runtime/migrate.mjs"]
    env_file:
      - .env
    environment: *runtime-environment
    volumes:
      - ./logs:/app/logs
      - ./runtime-secrets:/app/runtime-secrets
    depends_on:
      minio-init:
        condition: service_completed_successfully
      meilisearch-init:
        condition: service_completed_successfully
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    logging: *docker-logging
    restart: "no"

  postgres:
    image: postgres:18-alpine
    environment:
      POSTGRES_DB: ${POSTGRES_DB:?Set POSTGRES_DB in .env}
      POSTGRES_USER: ${POSTGRES_USER:?Set POSTGRES_USER in .env}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?Set POSTGRES_PASSWORD in .env}
    volumes:
      - ./data/postgres:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER:?Set POSTGRES_USER in .env} -d ${POSTGRES_DB:?Set POSTGRES_DB in .env}"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 10s
    logging: *docker-logging

  redis:
    image: redis:8-alpine
    command: ["redis-server", "--appendonly", "yes", "--auto-aof-rewrite-percentage", "100", "--auto-aof-rewrite-min-size", "8mb"]
    volumes:
      - ./data/redis:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 10
      start_period: 5s
    logging: *docker-logging

  minio:
    image: minio/minio:RELEASE.2025-09-07T16-13-09Z
    command: ["server", "/data", "--address", ":9000"]
    environment:
      MINIO_ROOT_USER: ${S3_ACCESS_KEY_ID:?Set S3_ACCESS_KEY_ID in .env}
      MINIO_ROOT_PASSWORD: ${S3_SECRET_ACCESS_KEY:?Set S3_SECRET_ACCESS_KEY in .env}
    volumes:
      - ./data/minio:/data
    healthcheck:
      test: ["CMD", "curl", "--fail", "--silent", "http://127.0.0.1:9000/minio/health/live"]
      interval: 5s
      timeout: 5s
      retries: 20
      start_period: 5s
    logging: *docker-logging

  minio-init:
    image: minio/mc:RELEASE.2025-08-13T08-35-41Z
    entrypoint: ["/bin/sh", "-c"]
    command:
      - >-
        mc alias set local http://minio:9000 "$${MINIO_ROOT_USER}" "$${MINIO_ROOT_PASSWORD}" &&
        mc mb --ignore-existing "local/$${S3_BUCKET}" &&
        mc version enable "local/$${S3_BUCKET}"
    environment:
      MINIO_ROOT_USER: ${S3_ACCESS_KEY_ID:?Set S3_ACCESS_KEY_ID in .env}
      MINIO_ROOT_PASSWORD: ${S3_SECRET_ACCESS_KEY:?Set S3_SECRET_ACCESS_KEY in .env}
      S3_BUCKET: ${S3_BUCKET:?Set S3_BUCKET in .env}
    depends_on:
      minio:
        condition: service_healthy
    logging: *docker-logging
    restart: "no"

  meilisearch:
    image: getmeili/meilisearch:v1.51.0
    profiles: ["bundled-search"]
    environment:
      MEILI_ENV: production
      MEILI_MASTER_KEY: ${MEILI_MASTER_KEY:?Set MEILI_MASTER_KEY in .env}
      MEILI_MAX_INDEXING_MEMORY: ${MEILI_MAX_INDEXING_MEMORY:?Set MEILI_MAX_INDEXING_MEMORY in .env}
      MEILI_MAX_INDEXING_THREADS: ${MEILI_MAX_INDEXING_THREADS:?Set MEILI_MAX_INDEXING_THREADS in .env}
      MEILI_SNAPSHOT_DIR: ${MEILI_SNAPSHOT_DIR:?Set MEILI_SNAPSHOT_DIR in .env}
      MEILI_SCHEDULE_SNAPSHOT: ${MEILI_SCHEDULE_SNAPSHOT:?Set MEILI_SCHEDULE_SNAPSHOT in .env}
      MEILI_DUMP_DIR: ${MEILI_DUMP_DIR:?Set MEILI_DUMP_DIR in .env}
      TMPDIR: /meili_data/tmp
      MEILI_NO_ANALYTICS: "true"
      MEILI_EXPERIMENTAL_ENABLE_METRICS: "true"
    volumes:
      - ./data/meilisearch:/meili_data
      - ./data/meilisearch/tmp:/meili_data/tmp
      - ./data/meilisearch-snapshots:/meili_snapshots
      - ./data/meilisearch-dumps:/meili_dumps
    healthcheck:
      test: ["CMD", "curl", "--fail", "--silent", "http://127.0.0.1:7700/health"]
      interval: 5s
      timeout: 5s
      retries: 20
      start_period: 15s
    logging: *docker-logging
