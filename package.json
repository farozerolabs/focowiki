{
  "name": "focowiki",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "node --import tsx scripts/dev-runtime.ts",
    "dev:api": "pnpm --filter @focowiki/api dev",
    "dev:admin": "pnpm --filter @focowiki/admin dev",
    "compose:config": "docker compose -f docker-compose.yml config",
    "compose:example:config": "docker compose --env-file .env.example -f docker-compose.yml.example config --no-env-resolution --quiet",
    "compose:pull": "docker compose -f docker-compose.yml pull",
    "compose:preflight": "docker compose -f docker-compose.yml run --rm --entrypoint node migrate apps/api/runtime/migration-preflight.mjs",
    "compose:migrate": "docker compose -f docker-compose.yml run --rm migrate",
    "compose:up": "docker compose -f docker-compose.yml up -d",
    "compose:down": "docker compose -f docker-compose.yml down",
    "compose:clean": "docker compose -f docker-compose.yml down --volumes --remove-orphans --rmi all",
    "compose:logs": "docker compose -f docker-compose.yml logs -f",
    "compose:backup": "node scripts/deployment/storage-vnext-backup.mjs",
    "compose:restore": "node scripts/deployment/storage-vnext-restore.mjs",
    "compose:ps": "docker compose -f docker-compose.yml ps",
    "compose:dev:config": "docker compose -f docker-compose.dev.yml config",
    "compose:dev:example:config": "docker compose --env-file .env.dev.example -f docker-compose.dev.yml.example config --no-env-resolution --quiet",
    "compose:dev:build": "docker compose -f docker-compose.dev.yml build",
    "compose:dev:migrate": "docker compose -f docker-compose.dev.yml run --rm migrate",
    "compose:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "compose:dev:down": "docker compose -f docker-compose.dev.yml down",
    "compose:dev:clean": "docker compose -f docker-compose.dev.yml down --volumes --remove-orphans --rmi all",
    "compose:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "compose:dev:ps": "docker compose -f docker-compose.dev.yml ps",
    "compose:local:config": "docker compose -f docker-compose.local.yml config",
    "compose:local:example:config": "docker compose --env-file .env.dev.example -f docker-compose.local.yml.example config --no-env-resolution --quiet",
    "compose:local:up": "docker compose -f docker-compose.local.yml up -d",
    "compose:local:down": "docker compose -f docker-compose.local.yml down",
    "compose:local:clean": "docker compose -f docker-compose.local.yml down --volumes --remove-orphans",
    "compose:local:ps": "docker compose -f docker-compose.local.yml ps",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "security:audit": "pnpm --config.registry=https://registry.npmjs.org audit --audit-level=low",
    "validate:generated-links": "node scripts/validation/generated-markdown-link-audit.mjs",
    "validate:admin-generated-links": "node scripts/validation/admin-generated-link-preview.mjs",
    "validate:openapi-continuity": "node scripts/validation/openapi-continuity.mjs",
    "validate:admin-build-debug-output": "node scripts/validation/admin-build-debug-output.mjs",
    "validate:storage-vnext:reset": "tsx apps/api/src/storage-vnext/bootstrap/main.ts reset",
    "validate:storage-vnext:bootstrap": "tsx apps/api/src/storage-vnext/bootstrap/main.ts bootstrap",
    "validate:no-local-paths": "node scripts/validation/no-local-path-leaks.mjs",
    "openapi:export": "tsx scripts/openapi/export-developer-openapi.ts",
    "openapi:check-docs-snapshot": "tsx scripts/openapi/check-developer-openapi-snapshot.ts",
    "openapi:validate": "tsx scripts/openapi/validate-developer-openapi.ts",
    "docs:generate-api": "tsx scripts/docs/generate-openapi-docs.ts",
    "docs:dev": "pnpm docs:generate-api && vitepress dev docs --host 127.0.0.1",
    "docs:build": "pnpm docs:generate-api && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "docs:test:explorer": "node --import tsx --test scripts/docs/test/swagger-api-explorer.test.ts",
    "docs:validate:browser": "node scripts/docs/validate-swagger-api-explorer.mjs",
    "docs:validate": "pnpm openapi:check-docs-snapshot && pnpm docs:generate-api && pnpm docs:test:explorer && tsx scripts/docs/validate-docs.ts && vitepress build docs",
    "test:validation": "pnpm docs:generate-api && node --test scripts/validation/test/*.test.mjs",
    "validate:portable-bundle-benchmark": "tsx scripts/validation/portable-bundle-v2-benchmark.ts",
    "validate:portable-bundle-static": "tsx scripts/validation/portable-bundle-static-review.ts"
  },
  "devDependencies": {
    "@redocly/cli": "2.35.1",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "swagger-ui-dist": "5.32.11",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitepress": "1.6.4",
    "vitest": "^4.1.8"
  }
}
