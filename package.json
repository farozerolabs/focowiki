{
  "name": "focowiki",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel --filter @focowiki/api --filter @focowiki/admin dev",
    "dev:api": "pnpm --filter @focowiki/api dev",
    "dev:admin": "pnpm --filter @focowiki/admin dev",
    "compose:config": "docker compose -f docker-compose.yml config",
    "compose:example:config": "docker compose --env-file .env.example -f docker-compose.yml.example config --no-env-resolution --quiet",
    "compose:pull": "docker compose -f docker-compose.yml pull",
    "compose:preflight": "docker compose -f docker-compose.yml run --rm --entrypoint node migrate apps/api/runtime/migration-preflight.mjs",
    "compose:migrate": "docker compose -f docker-compose.yml run --rm migrate",
    "compose:up": "docker compose -f docker-compose.yml up -d",
    "compose:down": "docker compose -f docker-compose.yml down",
    "compose:clean": "docker compose -f docker-compose.yml down --volumes --remove-orphans --rmi all",
    "compose:logs": "docker compose -f docker-compose.yml logs -f",
    "compose:backup": "node scripts/deployment/storage-vnext-backup.mjs",
    "compose:restore": "node scripts/deployment/storage-vnext-restore.mjs",
    "compose:ps": "docker compose -f docker-compose.yml ps",
    "compose:dev:config": "docker compose -f docker-compose.dev.yml config",
    "compose:dev:example:config": "docker compose --env-file .env.dev.example -f docker-compose.dev.yml.example config --no-env-resolution --quiet",
    "compose:dev:build": "docker compose -f docker-compose.dev.yml build",
    "compose:dev:migrate": "docker compose -f docker-compose.dev.yml run --rm migrate",
    "compose:dev:up": "docker compose -f docker-compose.dev.yml up -d",
    "compose:dev:down": "docker compose -f docker-compose.dev.yml down",
    "compose:dev:clean": "docker compose -f docker-compose.dev.yml down --volumes --remove-orphans --rmi all",
    "compose:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "compose:dev:ps": "docker compose -f docker-compose.dev.yml ps",
    "compose:local:config": "docker compose -f docker-compose.local.yml config",
    "compose:local:example:config": "docker compose --env-file .env.dev.example -f docker-compose.local.yml.example config --no-env-resolution --quiet",
    "compose:local:up": "docker compose -f docker-compose.local.yml up -d",
    "compose:local:down": "docker compose -f docker-compose.local.yml down",
    "compose:local:clean": "docker compose -f docker-compose.local.yml down --volumes --remove-orphans",
    "compose:local:ps": "docker compose -f docker-compose.local.yml ps",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "security:audit": "pnpm --config.registry=https://registry.npmjs.org audit --audit-level=low",
    "validate:cleaned-markdown:samples": "node scripts/validation/cleaned-markdown-flow.mjs samples",
    "validate:cleaned-markdown:api": "node scripts/validation/cleaned-markdown-flow.mjs api",
    "validate:cleaned-markdown:browser": "node scripts/validation/cleaned-markdown-browser.mjs",
    "validate:full-flow:e2e": "node scripts/validation/full-flow-e2e.mjs all",
    "validate:full-flow:large": "node scripts/validation/full-flow-e2e.mjs large",
    "validate:full-system:plan": "node scripts/validation/full-system-release-gate.mjs plan",
    "validate:full-system:baseline": "node scripts/validation/full-system-release-gate.mjs baseline",
    "validate:full-system:runtime": "node scripts/validation/full-system-release-gate.mjs runtime",
    "validate:full-system:all": "node scripts/validation/full-system-release-gate.mjs all",
    "validate:full-system:core-blackbox": "node scripts/validation/full-system-core-blackbox.mjs",
    "validate:large-scale:full-system": "node scripts/validation/large-scale-full-system-e2e.mjs all",
    "validate:large-scale:full-system:plan": "node scripts/validation/large-scale-full-system-e2e.mjs plan",
    "validate:generated-content": "node scripts/validation/generated-okf-file-inspection.mjs",
    "validate:generated-links": "node scripts/validation/generated-markdown-link-audit.mjs",
    "validate:admin-generated-links": "node scripts/validation/admin-generated-link-preview.mjs",
    "validate:openapi-continuity": "node scripts/validation/openapi-continuity.mjs",
    "validate:admin-build-debug-output": "node scripts/validation/admin-build-debug-output.mjs",
    "validate:storage-vnext:release-gate": "node scripts/validation/storage-vnext-release-gate.mjs",
    "validate:storage-vnext:scope": "node scripts/validation/storage-vnext-scope-gate.mjs",
    "validate:storage-vnext:reset": "tsx apps/api/src/storage-vnext/bootstrap/main.ts reset",
    "validate:storage-vnext:bootstrap": "tsx apps/api/src/storage-vnext/bootstrap/main.ts bootstrap",
    "validate:storage-vnext:restore-rebuild": "tsx scripts/validation/storage-vnext-restore-rebuild.ts",
    "validate:storage-vnext:full-restore-rebuild": "tsx scripts/validation/storage-vnext-full-restore-rebuild.ts",
    "validate:storage-vnext:scale-budget": "node scripts/validation/storage-vnext-scale-budget.mjs",
    "validate:storage-vnext:scale-concurrency": "node scripts/validation/run-storage-vnext-scale-concurrency.mjs",
    "validate:storage-vnext:scale-corpus": "node scripts/validation/storage-vnext-scale-corpus.mjs",
    "validate:storage-vnext:scale-rebuild": "node scripts/validation/run-storage-vnext-scale-rebuild.mjs",
    "validate:storage-vnext:full-corpus": "FOCOWIKI_STORAGE_VNEXT_CORPUS_MODE=full node scripts/validation/storage-vnext-scale-corpus.mjs",
    "validate:storage-vnext:full-rebuild": "FOCOWIKI_STORAGE_VNEXT_REBUILD_MODE=full node scripts/validation/run-storage-vnext-scale-rebuild.mjs",
    "validate:storage-vnext:scale-reads": "node scripts/validation/run-storage-vnext-scale-reads.mjs",
    "validate:storage-vnext:full-reads": "FOCOWIKI_STORAGE_VNEXT_READ_MODE=full node scripts/validation/run-storage-vnext-scale-reads.mjs",
    "validate:storage-vnext:scale-resources": "node scripts/validation/run-storage-vnext-scale-resources.mjs",
    "validate:storage-vnext:full-resources": "FOCOWIKI_STORAGE_VNEXT_RESOURCE_MODE=full node scripts/validation/run-storage-vnext-scale-resources.mjs",
    "validate:storage-vnext:full-verification": "node scripts/validation/run-storage-vnext-full-verification.mjs",
    "validate:storage-vnext:full-capacity": "node scripts/validation/run-storage-vnext-capacity-projection.mjs",
    "validate:storage-vnext:full-live-flows": "node scripts/validation/run-storage-vnext-full-live-flows.mjs",
    "validate:storage-vnext:runtime-flow": "node scripts/validation/capture-storage-vnext-runtime-flow-evidence.mjs",
    "validate:storage-vnext:scale-tuning": "node scripts/validation/run-storage-vnext-scale-tuning.mjs",
    "validate:storage-vnext:full-tuning": "FOCOWIKI_STORAGE_VNEXT_TUNING_MODE=full node scripts/validation/run-storage-vnext-scale-tuning.mjs",
    "validate:no-local-paths": "node scripts/validation/no-local-path-leaks.mjs",
    "openapi:export": "tsx scripts/openapi/export-developer-openapi.ts",
    "openapi:check-docs-snapshot": "tsx scripts/openapi/check-developer-openapi-snapshot.ts",
    "openapi:validate": "tsx scripts/openapi/validate-developer-openapi.ts",
    "docs:generate-api": "tsx scripts/docs/generate-openapi-docs.ts",
    "docs:dev": "pnpm docs:generate-api && vitepress dev docs --host 127.0.0.1",
    "docs:build": "pnpm docs:generate-api && vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "docs:test:explorer": "node --import tsx --test scripts/docs/test/swagger-api-explorer.test.ts",
    "docs:validate:browser": "node scripts/docs/validate-swagger-api-explorer.mjs",
    "docs:validate": "pnpm openapi:check-docs-snapshot && pnpm docs:generate-api && pnpm docs:test:explorer && tsx scripts/docs/validate-docs.ts && vitepress build docs",
    "test:validation": "tsx scripts/openapi/export-developer-openapi.ts && node --test scripts/validation/test/*.test.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.35.1",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "swagger-ui-dist": "5.32.11",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitepress": "1.6.4",
    "vitest": "^4.1.8"
  }
}
